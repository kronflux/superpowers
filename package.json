{
  "name": "superpowers",
  "version": "7.19.0",
  "description": "Superpowers skills and runtime bootstrap for coding agents",
  "author": "Richard M <richard@rmoser.ca>",
  "repository": "https://github.com/kronflux/superpowers",
  "type": "module",
  "main": ".opencode/plugins/superpowers.js",
  "keywords": [
    "pi-package",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/superpowers.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "pretest": "node tests/lint-skills.mjs",
    "test": "vitest run",
    "compile-hooks": "node scripts/compile-hooks.mjs"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
