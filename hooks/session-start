#!/usr/bin/env bash
# SessionStart hook for superpowers plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the SessionStart hook payload from stdin ({source, session_id, ...}).
# execSync-style harnesses that supply no input close stdin immediately, so
# this never blocks waiting for a terminal.
hook_stdin=$(cat 2>/dev/null || true)

# Tiering + dedupe decision (best-effort; requires node). sp-tmp.js is ESM,
# so the guard file's path and freshness check live in a Node subprocess
# rather than a bash reimplementation of spTmp()'s naming rule that could
# drift from it. Node unavailable, or the decision script producing anything
# other than "core"/"suppress", falls back to the full body with no dedupe —
# today's behaviour.
tier="full"
if command -v node >/dev/null 2>&1; then
    decision=$(printf '%s' "$hook_stdin" | node "${PLUGIN_ROOT}/hooks/lib/session-start-tiering.mjs" 2>/dev/null || true)
    if [ "$decision" = "suppress" ]; then
        printf '{}\n'
        exit 0
    elif [ "$decision" = "core" ]; then
        tier="core"
    fi
fi

# Read using-superpowers content. Full tier is the body only: the YAML
# frontmatter's name/description are already system-prompt-resident via the
# skill listing, so injecting them again would duplicate always-on context.
# Core tier is the region between the compact-core delimiters: the routing
# rules a compacting session still needs, without the Entry Sequence a
# compaction has already performed.
if [ "$tier" = "core" ]; then
    using_superpowers_content=$(awk '/<!-- compact-core:start -->/{c=1; next} /<!-- compact-core:end -->/{c=0; next} c{print}' \
        "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")
else
    using_superpowers_content=$(awk 'NR==1 && /^---[[:space:]]*$/ {fm=1; next} fm {if (/^---[[:space:]]*$/) fm=0; next} {print}' \
        "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")
fi

# Strip the subagent-only guard block from the injected payload: a subagent
# reading the skill through the Skill tool still needs it, but it costs bytes
# in every SessionStart emission to guard a path a main session never takes.
using_superpowers_content=$(printf '%s\n' "$using_superpowers_content" | awk '/<SUBAGENT-STOP>/{skip=1; next} /<\/SUBAGENT-STOP>/{skip=0; next} skip{next} {print}')

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have superpowers.\n\n**Your 'superpowers:using-superpowers' skill - how to find and use skills. Invoke all other skills via the 'Skill' tool:**\n\n${using_superpowers_escaped}\n</EXTREMELY_IMPORTANT>"

# Opt-in model routing: legacy-path migration notice only. The tier mapping
# and escalation rules surface at the first Agent dispatch instead
# (hooks/pre-agent-model-routing.js injects them there), the point at which
# they are relevant - most sessions never dispatch a subagent. A legacy
# config path is a one-time migration decision unrelated to dispatch, so it
# stays here. Fires only when the canonical project file is absent and the
# legacy project file resolves - config-dir/home-fallback candidates are not
# the deprecated path and get no migration offer. Kill switch or no legacy
# file -> output is byte-identical.
routing_legacy_file=""
if [ "${SUPERPOWERS_ROUTING_GUARD:-1}" != "0" ] \
   && [ ! -f "${PWD}/.superpowers/model-routing.json" ] \
   && [ -f "${PWD}/docs/superpowers/model-routing.json" ]; then
    routing_legacy_file="${PWD}/docs/superpowers/model-routing.json"
fi

if [ -n "$routing_legacy_file" ]; then
    routing_legacy_notice="<model-routing-legacy>
This project's model-routing config lives at ${routing_legacy_file} - offer the user a one-time migration to .superpowers/model-routing.json (canonical). An unmigrated legacy file is shadowed the moment a canonical file appears.
</model-routing-legacy>"
    routing_legacy_escaped=$(escape_for_json "$routing_legacy_notice")
    session_context="${session_context}\n\n${routing_legacy_escaped}"
fi

# Best-effort conductor capability probe: invokes the ESM capability
# registry (hooks/lib/capability-registry.js) via a Node subprocess, since
# this hook is bash and cannot import ESM directly. Failure of any kind
# (node missing, probe throws, etc.) must never break session start.
conductor_line=""
if command -v node >/dev/null 2>&1; then
    conductor_line=$(node "${PLUGIN_ROOT}/hooks/lib/session-start-probe.mjs" 2>/dev/null || true)
fi

if [ -n "$conductor_line" ]; then
    conductor_escaped=$(escape_for_json "$conductor_line")
    session_context="${session_context}\n\n${conductor_escaped}"
fi

# Best-effort interrupted-plan probe: invokes a Node subprocess (this hook is bash and
# cannot import ESM directly) that scans .superpowers/plans/*.tasks.json for a plan with
# open tasks and prints one line naming it. No qualifying plan, or the probe failing for
# any reason, must never break session start.
plan_restore_line=""
if command -v node >/dev/null 2>&1; then
    plan_restore_line=$(node "${PLUGIN_ROOT}/hooks/lib/session-start-plan-restore.mjs" 2>/dev/null || true)
fi

if [ -n "$plan_restore_line" ]; then
    plan_restore_escaped=$(escape_for_json "$plan_restore_line")
    session_context="${session_context}\n\n${plan_restore_escaped}"
fi

# Best-effort plugin version staleness probe: invokes a Node subprocess (this hook is bash and
# cannot import ESM directly) that compares CLAUDE_PLUGIN_ROOT's version segment against the
# newest version directory under the marketplace cache. A match, an unreadable cache, or a path
# that doesn't parse as a version prints nothing; must never break session start.
staleness_line=""
if command -v node >/dev/null 2>&1; then
    staleness_line=$(node "${PLUGIN_ROOT}/hooks/lib/session-start-version-staleness.mjs" 2>/dev/null || true)
fi

if [ -n "$staleness_line" ]; then
    staleness_escaped=$(escape_for_json "$staleness_line")
    session_context="${session_context}\n\n${staleness_escaped}"
fi

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
