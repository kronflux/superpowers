#!/usr/bin/env bash
# SessionStart hook for superpowers plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-superpowers content (body only: the YAML frontmatter's
# name/description are already system-prompt-resident via the skill listing,
# so injecting them again would duplicate always-on context).
using_superpowers_content=$(awk 'NR==1 && /^---[[:space:]]*$/ {fm=1; next} fm {if (/^---[[:space:]]*$/) fm=0; next} {print}' \
    "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have superpowers.\n\n**Your 'superpowers:using-superpowers' skill - how to find and use skills. Invoke all other skills via the 'Skill' tool:**\n\n${using_superpowers_escaped}\n</EXTREMELY_IMPORTANT>"

# Opt-in model routing: when the routing config exists (project first, then
# user-level fallback) and the kill switch is not set, append a
# <model-routing-active> block. Absent config -> output is byte-identical.
routing_file=""
if [ "${SUPERPOWERS_ROUTING_GUARD:-1}" != "0" ]; then
    if [ -f "${PWD}/docs/superpowers/model-routing.json" ]; then
        routing_file="${PWD}/docs/superpowers/model-routing.json"
    elif [ -f "${HOME:-}/.claude/superpowers/model-routing.json" ]; then
        routing_file="${HOME}/.claude/superpowers/model-routing.json"
    fi
fi

if [ -n "$routing_file" ]; then
    # Strip control chars (keep tab/newline/CR; escape_for_json handles those).
    routing_mapping=$(tr -d '\000-\010\013\014\016-\037\177' < "$routing_file" 2>/dev/null || true)
    routing_notice="<model-routing-active>
This project has opted in to subagent model routing (${routing_file}).
Tier mapping: ${routing_mapping}

Plan tasks carry \"modelTier\" in their json:metadata fence:
- \"mechanical\": 1-2 files, complete spec with code in the steps, no design judgment.
- \"standard\": multi-file coordination, integration, pattern matching, debugging. Reviewers always dispatch at standard.
- \"frontier\": design judgment, architecture decisions, broad codebase understanding.
Tie-break: spec completeness wins - complete code in steps means mechanical. Escalation goes up only (mechanical -> standard -> frontier), via TaskUpdate, never silently down. \"inherit\" in the mapping means no constraint. Full rules: docs/model-routing-flow.md. Kill switch: SUPERPOWERS_ROUTING_GUARD=0.
</model-routing-active>"
    routing_escaped=$(escape_for_json "$routing_notice")
    session_context="${session_context}\n\n${routing_escaped}"
fi

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
